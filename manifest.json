{
  "manifest_version": 3,
  "name": "Vrbow-wow: Vrbo Dog Policy Callout",
  "version": "1.0.1",
  "description": "Surfaces dog-friendliness details (dog limit, weight limit, pre-registration, fees) directly on Vrbo listing pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Vrbow-wow – Vrbo Dog Policy Callout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.vrbo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.vrbo.com/*"
      ],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.vrbo.com/*"
      ],
      "js": ["extract.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}
